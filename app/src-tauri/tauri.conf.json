{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Browser Vault",
  "identifier": "local.statusbar.helper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Encrypted vaults for Brave and Firefox profiles",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "disguises/browser-vault.icns": "disguises/browser-vault.icns",
      "disguises/fontcache.icns": "disguises/fontcache.icns",
      "disguises/displayprofile.icns": "disguises/displayprofile.icns",
      "disguises/archiveindex.icns": "disguises/archiveindex.icns"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "infoPlist": "Info.plist"
    }
  }
}
